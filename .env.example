# SEB Monitor — Environment Configuration
# Copy this file to .env and fill in your values.
# Used by docker-compose.yml

# Server port (default: 8000)
PORT=44513

# Dashboard login password (required for dashboard access)
DASHBOARD_PASSWORD=change-me-to-a-real-password

# Cookie signing secret (generate with: openssl rand -hex 32)
COOKIE_SECRET=change-me-to-a-random-32-char-string

# Pre-computed password hash (alternative to DASHBOARD_PASSWORD)
# Generate with: deno eval "console.log(await (await import('./server/src/services/auth.ts')).hashPassword('your-password'))"
# DASHBOARD_PASSWORD_HASH=100000.base64salt.base64hash

# Base path when behind a reverse proxy (e.g. /seb-monitor)
# Leave empty if serving at domain root
# BASE_PATH=/seb-monitor
